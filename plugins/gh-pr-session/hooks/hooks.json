{
  "modules": ["./register.ts"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "session-mcp",
            "tool": "gh_pr",
            "input": {
              "sessionID": "${session_id}",
              "tool_response": "${tool_response}"
            }
          }
        ]
      }
    ]
  }
}
