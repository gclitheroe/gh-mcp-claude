{
  "description": "Log pull requests the GitHub and Atlassian MCP servers create to session_mcp.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^mcp__github__create_pull_request$",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "session-mcp",
            "tool": "gh_pr",
            "input": {
              "sessionID": "${session_id}",
              "tool_response": "${tool_response}"
            },
            "timeout": 30,
            "statusMessage": "Logging the pull request to session_mcp"
          }
        ]
      },
      {
        "matcher": "^mcp__atlassian__executeWrite$",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "session-mcp",
            "tool": "bb_pr",
            "input": {
              "sessionID": "${session_id}",
              "operation": "${tool_input.name}",
              "tool_response": "${tool_response}"
            },
            "timeout": 30,
            "statusMessage": "Checking for a Bitbucket pull request"
          }
        ]
      }
    ]
  }
}
